        "jsbuild":{"MageMe_WebForms/js/steps.min.js":"define(['jquery','mage/validation','MageMe_WebForms/js/multistep'],function($){function multistep(options){const formId='webform_'+options.uid;const controls={form:document.getElementById(formId),wizard:document.getElementById('wizard'+options.uid)};function isIntersecting(el){return new Promise(resolve=>{const o=new IntersectionObserver(([entry])=>{resolve(entry.intersectionRatio===1);o.disconnect();});o.observe(el);});}\nconst validationCb=(form,valid)=>new Promise(async(resolve,reject)=>{if(!valid){resolve(false);}\nif(!($(controls.form).validation()&&$(controls.form).validation('isValid'))){resolve(false);}\nresolve(true);});const config={uid:options.uid,onFinish:function(){return validationCb(controls.form,true).then(valid=>{if(valid){if(window.mmForms&&window.mmForms[options.uid]){if(options.showReview){window.mmForms[options.uid].review();}else{window.mmForms[options.uid].submit();}}}else{throw new Error('jqstps');}}).catch(er=>{if(!controls.wizard){console.log('No wizard');return;}\nconst fieldset=controls.wizard.querySelector('.form-step.active fieldset');if(!fieldset||fieldset.style.display==='none'){return;}\nconst validator=$(controls.form).validate();fieldset.querySelectorAll('[name^=\"field\"]').forEach((field=>{if(!validator.element(field)){throw new Error('jqstps');}}));});},onChange:function(currentIndex,newIndex,stepDirection){if(stepDirection==='forward'){return validationCb(controls.form,true).then(valid=>{if(valid&&controls.wizard){isIntersecting(controls.wizard).then(result=>{if(!result){window.scrollTo({top:controls.wizard.offsetTop-20,behavior:'smooth'});}});}else{throw new Error('jqstps');}}).catch(er=>{if(!controls.wizard){console.log('No wizard');return;}\nconst fieldset=controls.wizard.querySelector('.form-step.active fieldset');if(!fieldset){console.log('No fieldset');return;}\nif(fieldset.style.display==='none'){return;}\nif(fieldset.classList.contains('mm-logic-hidden')){return;}\nc